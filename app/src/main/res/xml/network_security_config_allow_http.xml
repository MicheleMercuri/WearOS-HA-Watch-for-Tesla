<?xml version="1.0" encoding="utf-8"?>
<!-- Used only with ha.allow_http=true: plain http is allowed, the token travels unencrypted -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
